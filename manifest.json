{
  "manifest_version": 3,
  "name": "GreenPrompt",
  "version": "1.0",
  "description": "Gemini Prompt Sustainability Optimizer",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://gemini.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["impact/impact.js", "content.js"]
    }
  ]
}